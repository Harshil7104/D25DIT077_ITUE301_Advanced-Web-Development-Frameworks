# Practical 13 Backend Gitignore
# Dependencies
node_modules/

# Test coverage & reports
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables (exclude real secrets, permit template example)
.env
.env.*
.env.local
!.env.example

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
