# Practical 13 Root Gitignore

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.vite/
**/.vite/

# Test coverage & reports
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/

# Environment files (exclude secret keys, allow example templates)
.env
**/.env
.env.*
**/.env.*
.env.local
**/.env.local
!.env.example
!**/.env.example

# Docker Local Overrides
docker-compose.override.yml

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
