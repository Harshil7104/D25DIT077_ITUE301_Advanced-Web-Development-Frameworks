# Practical 9: In-Memory Caching Backend Configuration Example
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Fallback to mongodb-memory-server if local/Atlas unavailable)
MONGO_URI=mongodb://127.0.0.1:27017/taskmanager_practical9

# In-Memory Cache Configuration (node-cache)
CACHE_TTL=60
CACHE_CHECK_PERIOD=120
